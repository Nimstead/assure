# Copy to .env next to compose.yaml. Every setting is in docs/configuration.md.

# Required before agents on other machines can enrol: the HTTPS address they'll use
NIMSTEAD_PUBLIC_URL=http://localhost:8000

# Set a long random value before the first `docker compose up` (it's fixed into the database volume then)
POSTGRES_PASSWORD=change-me

# Port on this machine
NIMSTEAD_PORT=8000

# Your reverse proxy's address, so sign-in throttling sees real client addresses
FORWARDED_ALLOW_IPS=127.0.0.1

# Which releases to take: stable (default), beta (also stable), or preview (everything, earliest).
# Read by Settings (update available) and deploy/update.sh. There's no stable release yet: trial installs use preview.
NIMSTEAD_UPDATE_CHANNEL=stable

# Until you set this to 1, fixes only run on hosts enrolled with a sandbox token
NIMSTEAD_ALLOW_PRODUCTION_REMEDIATION=0

# Optional: plain-English explanations and natural-language search
ANTHROPIC_API_KEY=

# Optional: email alerts (smtp://user:pass@host:587 uses STARTTLS; smtps://host:465)
NIMSTEAD_SMTP_URL=
NIMSTEAD_SMTP_FROM=
